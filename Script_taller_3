import os
import cv2
import numpy as np
import pandas as pd
import pydicom


class ProcesadorDICOM:
    

    def __init__(self, carpeta_dicom, carpeta_salida):
        self.carpeta_dicom = carpeta_dicom
        self.carpeta_salida = carpeta_salida
        self.archivos_dicom = []
        self.metadata = []

    
        os.makedirs(
            os.path.join(carpeta_salida, "ecualizadas"),
            exist_ok=True
        )

        os.makedirs(
            os.path.join(carpeta_salida, "bordes"),
            exist_ok=True
        )
    def cargar_dicoms(self):

        if not os.path.exists(self.carpeta_dicom):

            print("La carpeta no existe")

            return

        archivos = os.listdir(self.carpeta_dicom)

        print("Archivos encontrados:")
        print(archivos)

        for archivo in archivos:

            ruta = os.path.join(
                self.carpeta_dicom,
                archivo
            )

  
            if os.path.isdir(ruta):
                continue

            try:

                dicom = pydicom.dcmread(ruta)

                self.archivos_dicom.append(
                    (archivo, dicom)
                )

                print(f"[OK] DICOM cargado: {archivo}")

            except Exception as e:

                print(f"[ERROR] {archivo}: {e}")


    def extraer_metadatos(self):

        for nombre_archivo, dicom in self.archivos_dicom:

            try:

                datos = {

                    "Archivo": nombre_archivo,

                    "IDPaciente":
                        getattr(dicom, "PatientID", "No disponible"),

                    "Nombrepaciente":
                        str(getattr(
                            dicom,
                            "Nombrepaciente",
                            "No disponible"
                        )),

                    "ID estudio":
                        getattr(
                            dicom,
                            "ID estudio",
                            "No disponible"
                        ),

                    "descripcion estudio":
                        getattr(
                            dicom,
                            "descripcion estudio",
                            "No disponible"
                        ),

                    "Fecha estudio":
                        getattr(
                            dicom,
                            "Fecha estudio",
                            "No disponible"
                        ),

                    "Modalidad":
                        getattr(
                            dicom,
                            "Modalidad",
                            "No disponible"
                        ),

                    "filas":
                        getattr(
                            dicom,
                            "filas",
                            "No disponible"
                        ),

                    "Columnas":
                        getattr(
                            dicom,
                            "Columnas",
                            "No disponible"
                        )
                }

                try:

                    imagen = dicom.pixel_array.astype(np.float32)

                    intensidad_promedio = np.mean(imagen)

                    datos["IntensidadPromedio"] = \
                        round(float(intensidad_promedio), 2)

                except Exception:

                    datos["IntensidadPromedio"] = \
                        "Sin imagen"

                self.metadata.append(datos)

            except Exception as e:

                print(
                    f"Error extrayendo metadata "
                    f"de {nombre_archivo}: {e}"
                )
    def procesar_imagenes(self):

        for nombre_archivo, dicom in self.archivos_dicom:

            try:

                imagen = dicom.pixel_array


                imagen_norm = cv2.normalize(
                    imagen,
                    None,
                    0,
                    255,
                    cv2.NORM_MINMAX
                )

                imagen_norm = np.uint8(imagen_norm)

                if len(imagen_norm.shape) == 3:

                    imagen_norm = cv2.cvtColor(
        imagen_norm,
        cv2.COLOR_BGR2GRAY
    )


                ecualizada = cv2.equalizeHist(
    imagen_norm
)



                bordes = cv2.Canny(
                    ecualizada,
                    50,
                    150
                )


                nombre_base = os.path.splitext(
                    nombre_archivo
                )[0]

                ruta_ecualizada = os.path.join(
                    self.carpeta_salida,
                    "ecualizadas",
                    f"{nombre_base}_eq.png"
                )

                ruta_bordes = os.path.join(
                    self.carpeta_salida,
                    "bordes",
                    f"{nombre_base}_bordes.png"
                )

                cv2.imwrite(
                    ruta_ecualizada,
                    ecualizada
                )

                cv2.imwrite(
                    ruta_bordes,
                    bordes
                )

                print(
                    f"[OK] Procesada: {nombre_archivo}"
                )

            except Exception as e:

                print(
                    f"[ERROR] Procesando "
                    f"{nombre_archivo}: {e}"
                )


    def crear_dataframe(self):

        df = pd.DataFrame(self.metadata)

        return df
    def exportar_csv(self, df):

        ruta_csv = os.path.join(
            self.carpeta_salida,
            "metadata_dicom.csv"
        )

        df.to_csv(
            ruta_csv,
            index=False
        )

        print(f" CSV guardado en: {ruta_csv}")


if __name__ == "__main__":


    carpeta_dicom = "datos_dicom"
    carpeta_salida = "resultados"

    if not os.path.exists(carpeta_dicom):
        os.makedirs(carpeta_dicom)
        print(f"Se ha creado la carpeta '{carpeta_dicom}' automáticamente.")
        print(f"Por favor, coloca tus archivos .dcm dentro de ella y vuelve a ejecutar el programa.")
    else:

        procesador = ProcesadorDICOM(
            carpeta_dicom,
            carpeta_salida
        )

        procesador.cargar_dicoms()
        
        if len(procesador.archivos_dicom) > 0:
            procesador.extraer_metadatos()
            procesador.procesar_imagenes()

            df = procesador.crear_dataframe()
            print("\n DATAFRAME \n")
            print(df)

            procesador.exportar_csv(df)
            print(f"\n Archivo guardado en la carpeta: {os.path.abspath(carpeta_salida)}")
        else:
            print(f"No se encontraron archivos para procesar dentro de '{carpeta_dicom}'.")