import os
import cv2
import numpy as np
import pandas as pd
import pydicom


class ProcesadorDICOM:
    

    def __init__(self, carpeta_dicom, carpeta_salida):
        self.carpeta_dicom = carpeta_dicom
        self.carpeta_salida = carpeta_salida
        self.archivos_dicom = []
        self.metadata = []

    
        os.makedirs(
            os.path.join(carpeta_salida, "ecualizadas"),
            exist_ok=True
        )

        os.makedirs(
            os.path.join(carpeta_salida, "bordes"),
            exist_ok=True
        )
    def cargar_dicoms(self):

        if not os.path.exists(self.carpeta_dicom):

            print("La carpeta no existe")

            return

        archivos = os.listdir(self.carpeta_dicom)

        print("Archivos encontrados:")
        print(archivos)

        for archivo in archivos:

            ruta = os.path.join(
                self.carpeta_dicom,
                archivo
            )

  
            if os.path.isdir(ruta):
                continue

            try:

                dicom = pydicom.dcmread(ruta)

                self.archivos_dicom.append(
                    (archivo, dicom)
                )

                print(f"[OK] DICOM cargado: {archivo}")

            except Exception as e:

                print(f"[ERROR] {archivo}: {e}")


    def extraer_metadatos(self):

        for nombre_archivo, dicom in self.archivos_dicom:

            try:

                datos = {

                    "Archivo": nombre_archivo,

                    "IDPaciente":
                        getattr(dicom, "PatientID", "No disponible"),

                    "Nombrepaciente":
                        str(getattr(
                            dicom,
                            "Nombrepaciente",
                            "No disponible"
                        )),

                    "ID estudio":
                        getattr(
                            dicom,
                            "ID estudio",
                            "No disponible"
                        ),

                    "descripcion estudio":
                        getattr(
                            dicom,
                            "descripcion estudio",
                            "No disponible"
                        ),

                    "Fecha estudio":
                        getattr(
                            dicom,
                            "Fecha estudio",
                            "No disponible"
                        ),

                    "Modalidad":
                        getattr(
                            dicom,
                            "Modalidad",
                            "No disponible"
                        ),

                    "filas":
                        getattr(
                            dicom,
                            "filas",
                            "No disponible"
                        ),

                    "Columnas":
                        getattr(
                            dicom,
                            "Columnas",
                            "No disponible"
                        )
                }

                try:

                    imagen = dicom.pixel_array.astype(np.float32)

                    intensidad_promedio = np.mean(imagen)

                    datos["IntensidadPromedio"] = \
                        round(float(intensidad_promedio), 2)

                except Exception:

                    datos["IntensidadPromedio"] = \
                        "Sin imagen"

                self.metadata.append(datos)

            except Exception as e:

                print(
                    f"Error extrayendo metadata "
                    f"de {nombre_archivo}: {e}"
                )
